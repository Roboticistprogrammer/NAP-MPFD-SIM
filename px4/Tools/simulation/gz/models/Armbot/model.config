<?xml version="1.0"?>
<model>
  <name>Armbot</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Amir</name>
  </author>
  <description>
    Robotistan ArmBot 5-axis arm, reconstructed from photo measurements and spec sheet (no manufacturer CAD available). Links are primitive solids (cylinders/boxes) sized to match measured/assumed dimensions; joint chain is base_yaw -&gt; shoulder_pitch -&gt; elbow_pitch -&gt; wrist (currently fixed, slot for unconfirmed 5th axis) -&gt; gripper_joint. Replace meshes/*.stl with real Fusion 360 exports once modeled.
  </description>
</model>
