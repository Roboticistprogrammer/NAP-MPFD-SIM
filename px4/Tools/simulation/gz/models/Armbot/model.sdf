<?xml version="1.0"?>
<sdf version="1.9">
  <model name="armbot">
    <static>false</static>

    <link name="base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.0475 0 0 0</pose>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.000288</ixx><iyy>0.000288</iyy><izz>0.0002</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <geometry><mesh><uri>meshes/base_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
      </visual>
      <collision name="base_link_collision">
        <geometry><mesh><uri>meshes/base_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
    </link>

    <link name="turntable_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.1025 0 0 0</pose>
        <mass>0.06</mass>
        <inertia>
          <ixx>0.0000507</ixx><iyy>0.0000507</iyy><izz>0.0000992</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="turntable_link_visual">
        <geometry><mesh><uri>meshes/turntable_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
      </visual>
      <collision name="turntable_link_collision">
        <geometry><mesh><uri>meshes/turntable_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
    </link>

    <link name="upper_arm_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.0225 0 0.110 0 0 0</pose>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.0000078</ixx><iyy>0.0000656</iyy><izz>0.0000703</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="upper_arm_link_visual">
        <geometry><mesh><uri>meshes/upper_arm_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.9 0.55 0.1 1</ambient><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <collision name="upper_arm_link_collision">
        <geometry><mesh><uri>meshes/upper_arm_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
    </link>

    <link name="forearm_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.1775 0 0.110 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.0000115</ixx><iyy>0.0000482</iyy><izz>0.0000571</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="forearm_link_visual">
        <geometry><mesh><uri>meshes/forearm_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.95 0.7 0.2 1</ambient><diffuse>0.95 0.7 0.2 1</diffuse></material>
      </visual>
      <collision name="forearm_link_collision">
        <geometry><mesh><uri>meshes/forearm_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
    </link>

    <!-- ===== Two-jaw claw (servo-like), replaces the force-controlled parallel fingers =====
         Matches the real ArmBot claw in kind: two pivoting jaws closed by one 9 g servo
         through a linkage (real: open at 0 and 180 deg, fully closed at 96 deg; see
         NAP-MPFD armbot_gripper_logger). Dimensions are estimates from product photos
         (+-30 %), adjusted so the 50 mm test cylinder fits and the jaw tips clear the table.

         Geometry, model frame, all joints at zero (arm along +x, centreline z = 0.110):
           palm face             x = 0.2725
           grasp point (centre)  x = 0.3025, y = 0, z = 0.110   (unchanged)
           jaw pivots            x = 0.2725, z = 0.110 +- 0.020 (axis along y = cylinder axis)
           jaws                  55 mm long, 14 mm wide (along y), inner face through the pivot
           pads                  two per jaw, 35 x 4 x 2 mm, at 17.5-52.5 mm from the pivot, y = +-4 mm
         Joint angle q: 0 = jaw parallel to the arm, + closes, - opens (open ~ -0.6 rad).

         Actuation (ASSUMPTIONS, see 09_fsr_plan.md): each jaw follows a position command like
         a hobby servo: JointPositionController with a P gain (servo stiffness through the
         linkage) and a torque limit (stall torque through the linkage). The squeeze is
         therefore a physical outcome: gain x (commanded angle - angle at which the cylinder
         stops the jaw), capped by the torque limit; it changes if the cylinder moves.
         Command topics /model/armbot/joint/jaw_{left,right}_joint/cmd_pos (gz.msgs.Double, rad).
         Contact sensors on every pad (/model/armbot/jaw_*/pad_*/contact) stand for the FSRs;
         they need gz-sim-contact-system in the world. -->
    <link name="gripper_base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.2625 0 0.110 0 0 0</pose>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.0000265</ixx><iyy>0.0000213</iyy><izz>0.0000072</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="palm_visual">
        <pose>0.2625 0 0.110 0 0 0</pose>
        <geometry><box><size>0.02 0.05 0.11</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="palm_collision">
        <pose>0.2625 0 0.110 0 0 0</pose>
        <geometry><box><size>0.02 0.05 0.11</size></box></geometry>
      </collision>
    </link>


    <link name="jaw_left_link">
      <pose relative_to="jaw_left_joint"/>
      <inertial>
        <pose>0.0275 0 0.003 0 0 0</pose>
        <mass>0.008</mass>
        <!-- ASSUMPTION: iyy/izz raised from ~2e-6 to stand for the servo rotor and
             linkage inertia reflected through the gearbox (keeps the 4 ms step stable). -->
        <inertia><ixx>0.000002</ixx><iyy>0.00004</iyy><izz>0.00004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="jaw_visual">
        <pose>0.0275 0 0.003 0 0 0</pose>
        <geometry><box><size>0.055 0.014 0.006</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="jaw_collision">
        <pose>0.0275 0 0.003 0 0 0</pose>
        <geometry><box><size>0.055 0.014 0.006</size></box></geometry>
      </collision>
      <collision name="pad_a">
        <pose>0.035 0.004 -0.001 0 0 0</pose>
        <geometry><box><size>0.035 0.004 0.002</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="pad_a_visual">
        <pose>0.035 0.004 -0.001 0 0 0</pose>
        <geometry><box><size>0.035 0.004 0.002</size></box></geometry>
        <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
      </visual>
      <collision name="pad_b">
        <pose>0.035 -0.004 -0.001 0 0 0</pose>
        <geometry><box><size>0.035 0.004 0.002</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="pad_b_visual">
        <pose>0.035 -0.004 -0.001 0 0 0</pose>
        <geometry><box><size>0.035 0.004 0.002</size></box></geometry>
        <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
      </visual>
      <sensor name="pad_a_contact" type="contact">
        <contact><collision>pad_a</collision><topic>/model/armbot/jaw_left/pad_a/contact</topic></contact>
        <update_rate>250</update_rate>
        <always_on>1</always_on>
      </sensor>
      <sensor name="pad_b_contact" type="contact">
        <contact><collision>pad_b</collision><topic>/model/armbot/jaw_left/pad_b/contact</topic></contact>
        <update_rate>250</update_rate>
        <always_on>1</always_on>
      </sensor>
    </link>

    <link name="jaw_right_link">
      <pose relative_to="jaw_right_joint"/>
      <inertial>
        <pose>0.0275 0 -0.003 0 0 0</pose>
        <mass>0.008</mass>
        <!-- ASSUMPTION: iyy/izz raised from ~2e-6 to stand for the servo rotor and
             linkage inertia reflected through the gearbox (keeps the 4 ms step stable). -->
        <inertia><ixx>0.000002</ixx><iyy>0.00004</iyy><izz>0.00004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="jaw_visual">
        <pose>0.0275 0 -0.003 0 0 0</pose>
        <geometry><box><size>0.055 0.014 0.006</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="jaw_collision">
        <pose>0.0275 0 -0.003 0 0 0</pose>
        <geometry><box><size>0.055 0.014 0.006</size></box></geometry>
      </collision>
      <collision name="pad_a">
        <pose>0.035 0.004 0.001 0 0 0</pose>
        <geometry><box><size>0.035 0.004 0.002</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="pad_a_visual">
        <pose>0.035 0.004 0.001 0 0 0</pose>
        <geometry><box><size>0.035 0.004 0.002</size></box></geometry>
        <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
      </visual>
      <collision name="pad_b">
        <pose>0.035 -0.004 0.001 0 0 0</pose>
        <geometry><box><size>0.035 0.004 0.002</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="pad_b_visual">
        <pose>0.035 -0.004 0.001 0 0 0</pose>
        <geometry><box><size>0.035 0.004 0.002</size></box></geometry>
        <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
      </visual>
      <sensor name="pad_a_contact" type="contact">
        <contact><collision>pad_a</collision><topic>/model/armbot/jaw_right/pad_a/contact</topic></contact>
        <update_rate>250</update_rate>
        <always_on>1</always_on>
      </sensor>
      <sensor name="pad_b_contact" type="contact">
        <contact><collision>pad_b</collision><topic>/model/armbot/jaw_right/pad_b/contact</topic></contact>
        <update_rate>250</update_rate>
        <always_on>1</always_on>
      </sensor>
    </link>

    <joint name="base_yaw_joint" type="revolute">
      <parent>base_link</parent>
      <child>turntable_link</child>
      <pose relative_to="__model__">0 0 0.095 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit><lower>-3.14</lower><upper>3.14</upper><effort>2</effort><velocity>3</velocity></limit>
      </axis>
    </joint>

    <joint name="shoulder_pitch_joint" type="revolute">
      <parent>turntable_link</parent>
      <child>upper_arm_link</child>
      <pose relative_to="__model__">-0.0575 0 0.110 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>2</effort><velocity>3</velocity></limit>
      </axis>
    </joint>

    <joint name="elbow_pitch_joint" type="revolute">
      <parent>upper_arm_link</parent>
      <child>forearm_link</child>
      <pose relative_to="__model__">0.1025 0 0.110 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>2</effort><velocity>3</velocity></limit>
      </axis>
    </joint>

    <joint name="wrist_joint" type="fixed">
      <parent>forearm_link</parent>
      <child>gripper_base_link</child>
      <pose relative_to="__model__">0.2525 0 0.110 0 0 0</pose>
    </joint>

    <joint name="jaw_left_joint" type="revolute">
      <parent>gripper_base_link</parent>
      <child>jaw_left_link</child>
      <pose relative_to="__model__">0.2725 0 0.130 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-0.8</lower><upper>0.35</upper><effort>0.15</effort><velocity>6</velocity></limit>
        <dynamics><damping>0.005</damping></dynamics>
      </axis>
    </joint>

    <joint name="jaw_right_joint" type="revolute">
      <parent>gripper_base_link</parent>
      <child>jaw_right_link</child>
      <pose relative_to="__model__">0.2725 0 0.090 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 -1 0</xyz>
        <limit><lower>-0.8</lower><upper>0.35</upper><effort>0.15</effort><velocity>6</velocity></limit>
        <dynamics><damping>0.005</damping></dynamics>
      </axis>
    </joint>

    <!-- Basic per-joint position control + state publishing for standalone gz sim use.
         If this arm will instead be driven through ROS 2 (gz_ros2_control, like the
         original xacro), remove these plugins and spawn robot_description the way
         section 7 of the guide describes instead. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/armbot/joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>base_yaw_joint</joint_name>
      <topic>/model/armbot/joint/base_yaw_joint/cmd_pos</topic>
      <p_gain>5</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_pitch_joint</joint_name>
      <topic>/model/armbot/joint/shoulder_pitch_joint/cmd_pos</topic>
      <p_gain>5</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_pitch_joint</joint_name>
      <topic>/model/armbot/joint/elbow_pitch_joint/cmd_pos</topic>
      <p_gain>5</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>jaw_left_joint</joint_name>
      <topic>/model/armbot/joint/jaw_left_joint/cmd_pos</topic>
      <!-- ASSUMPTION: servo stiffness 0.6 N m/rad and stall torque 0.15 N m at the jaw -->
      <p_gain>0.6</p_gain>
      <d_gain>0.01</d_gain>
      <cmd_max>0.15</cmd_max>
      <cmd_min>-0.15</cmd_min>
      <initial_position>-0.6</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>jaw_right_joint</joint_name>
      <topic>/model/armbot/joint/jaw_right_joint/cmd_pos</topic>
      <!-- ASSUMPTION: servo stiffness 0.6 N m/rad and stall torque 0.15 N m at the jaw -->
      <p_gain>0.6</p_gain>
      <d_gain>0.01</d_gain>
      <cmd_max>0.15</cmd_max>
      <cmd_min>-0.15</cmd_min>
      <initial_position>-0.6</initial_position>
    </plugin>
  </model>
</sdf>
