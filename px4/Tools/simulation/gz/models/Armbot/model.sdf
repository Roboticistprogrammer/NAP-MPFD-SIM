<?xml version="1.0"?>
<sdf version="1.9">
  <model name="armbot">
    <static>false</static>

    <link name="base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.0475 0 0 0</pose>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.000288</ixx><iyy>0.000288</iyy><izz>0.0002</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="base_link_visual">
        <geometry><mesh><uri>meshes/base_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
      </visual>
      <collision name="base_link_collision">
        <geometry><mesh><uri>meshes/base_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
    </link>

    <link name="turntable_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.1025 0 0 0</pose>
        <mass>0.06</mass>
        <inertia>
          <ixx>0.0000507</ixx><iyy>0.0000507</iyy><izz>0.0000992</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="turntable_link_visual">
        <geometry><mesh><uri>meshes/turntable_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
      </visual>
      <collision name="turntable_link_collision">
        <geometry><mesh><uri>meshes/turntable_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
    </link>

    <link name="upper_arm_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.0225 0 0.110 0 0 0</pose>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.0000078</ixx><iyy>0.0000656</iyy><izz>0.0000703</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="upper_arm_link_visual">
        <geometry><mesh><uri>meshes/upper_arm_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.9 0.55 0.1 1</ambient><diffuse>0.9 0.55 0.1 1</diffuse></material>
      </visual>
      <collision name="upper_arm_link_collision">
        <geometry><mesh><uri>meshes/upper_arm_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
    </link>

    <link name="forearm_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.1775 0 0.110 0 0 0</pose>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.0000115</ixx><iyy>0.0000482</iyy><izz>0.0000571</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="forearm_link_visual">
        <geometry><mesh><uri>meshes/forearm_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.95 0.7 0.2 1</ambient><diffuse>0.95 0.7 0.2 1</diffuse></material>
      </visual>
      <collision name="forearm_link_collision">
        <geometry><mesh><uri>meshes/forearm_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
    </link>

    <!-- ===== Two-finger parallel gripper =====
         Replaces the original single hinged jaw_link (a 6 cm rod against a
         2 cm block, which had no opposing surface and could not hold
         anything; original kept as model.sdf.orig).

         Geometry, in this model's frame with all joints at zero (arm
         pointing along +x, centreline z = 0.110):
           palm face             x = 0.2725
           grasp point (centre)  x = 0.3025, y = 0, z = 0.110
           fingers               x 0.2725 .. 0.3275 (55 mm long)
         The fingers slide along z (perpendicular to the arm and to the
         cylinder axis, which must lie along the model's y axis), so with
         the arm pointing straight down they pinch horizontally.
         Pad-to-pad gap: 76 mm open, 6 mm fully closed; a 50 mm cylinder
         is touched after 13 mm of travel per finger.

         Each finger touches the object through two small pads 20 mm apart
         along y. That fixes the contact layout, so the friction torque
         resisting rotation about the pinch axis (the off-centre grasp
         failure mode) is well defined instead of depending on how the
         solver happens to discretise a flat-face line contact.

         Actuation is force control: ApplyJointForce on each finger,
         topics /model/armbot/joint/finger_{left,right}_joint/cmd_force
         (gz.msgs.Double, newtons, + closes, - opens). The commanded force
         is the experiment's "grip level". -->
    <link name="gripper_base_link">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0.2625 0 0.110 0 0 0</pose>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.0000265</ixx><iyy>0.0000213</iyy><izz>0.0000072</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="palm_visual">
        <pose>0.2625 0 0.110 0 0 0</pose>
        <geometry><box><size>0.02 0.05 0.11</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <collision name="palm_collision">
        <pose>0.2625 0 0.110 0 0 0</pose>
        <geometry><box><size>0.02 0.05 0.11</size></box></geometry>
      </collision>
    </link>

    <link name="finger_left_link">
      <!-- open position: inner face at z = 0.110 + 0.040 -->
      <pose relative_to="__model__">0.3000 0 0.154 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0000008</ixx><iyy>0.0000026</iyy><izz>0.0000033</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="finger_visual">
        <geometry><box><size>0.055 0.03 0.008</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="finger_collision">
        <geometry><box><size>0.055 0.03 0.008</size></box></geometry>
      </collision>
      <collision name="pad_a">
        <pose>0.0025 0.010 -0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.008 0.002</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <collision name="pad_b">
        <pose>0.0025 -0.010 -0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.008 0.002</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="pad_a_visual">
        <pose>0.0025 0.010 -0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.008 0.002</size></box></geometry>
        <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
      </visual>
      <visual name="pad_b_visual">
        <pose>0.0025 -0.010 -0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.008 0.002</size></box></geometry>
        <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
      </visual>
    </link>

    <link name="finger_right_link">
      <!-- open position: inner face at z = 0.110 - 0.040 -->
      <pose relative_to="__model__">0.3000 0 0.066 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0000008</ixx><iyy>0.0000026</iyy><izz>0.0000033</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="finger_visual">
        <geometry><box><size>0.055 0.03 0.008</size></box></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <collision name="finger_collision">
        <geometry><box><size>0.055 0.03 0.008</size></box></geometry>
      </collision>
      <collision name="pad_a">
        <pose>0.0025 0.010 0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.008 0.002</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <collision name="pad_b">
        <pose>0.0025 -0.010 0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.008 0.002</size></box></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="pad_a_visual">
        <pose>0.0025 0.010 0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.008 0.002</size></box></geometry>
        <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
      </visual>
      <visual name="pad_b_visual">
        <pose>0.0025 -0.010 0.005 0 0 0</pose>
        <geometry><box><size>0.035 0.008 0.002</size></box></geometry>
        <material><ambient>0.85 0.2 0.15 1</ambient><diffuse>0.85 0.2 0.15 1</diffuse></material>
      </visual>
    </link>

    <joint name="base_yaw_joint" type="revolute">
      <parent>base_link</parent>
      <child>turntable_link</child>
      <pose relative_to="__model__">0 0 0.095 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit><lower>-3.14</lower><upper>3.14</upper><effort>2</effort><velocity>3</velocity></limit>
      </axis>
    </joint>

    <joint name="shoulder_pitch_joint" type="revolute">
      <parent>turntable_link</parent>
      <child>upper_arm_link</child>
      <pose relative_to="__model__">-0.0575 0 0.110 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>2</effort><velocity>3</velocity></limit>
      </axis>
    </joint>

    <joint name="elbow_pitch_joint" type="revolute">
      <parent>upper_arm_link</parent>
      <child>forearm_link</child>
      <pose relative_to="__model__">0.1025 0 0.110 0 0 0</pose>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit><lower>-1.57</lower><upper>1.57</upper><effort>2</effort><velocity>3</velocity></limit>
      </axis>
    </joint>

    <joint name="wrist_joint" type="fixed">
      <parent>forearm_link</parent>
      <child>gripper_base_link</child>
      <pose relative_to="__model__">0.2525 0 0.110 0 0 0</pose>
    </joint>

    <!-- + q closes (moves toward the centreline). 0 = open, 0.035 = closed. -->
    <joint name="finger_left_joint" type="prismatic">
      <parent>gripper_base_link</parent>
      <child>finger_left_link</child>
      <axis>
        <xyz expressed_in="__model__">0 0 -1</xyz>
        <limit><lower>0</lower><upper>0.035</upper><effort>50</effort><velocity>0.5</velocity></limit>
        <dynamics><damping>2.0</damping></dynamics>
      </axis>
    </joint>

    <joint name="finger_right_joint" type="prismatic">
      <parent>gripper_base_link</parent>
      <child>finger_right_link</child>
      <axis>
        <xyz expressed_in="__model__">0 0 1</xyz>
        <limit><lower>0</lower><upper>0.035</upper><effort>50</effort><velocity>0.5</velocity></limit>
        <dynamics><damping>2.0</damping></dynamics>
      </axis>
    </joint>

    <!-- Basic per-joint position control + state publishing for standalone gz sim use.
         If this arm will instead be driven through ROS 2 (gz_ros2_control, like the
         original xacro), remove these plugins and spawn robot_description the way
         section 7 of the guide describes instead. -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/armbot/joint_states</topic>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>base_yaw_joint</joint_name>
      <topic>/model/armbot/joint/base_yaw_joint/cmd_pos</topic>
      <p_gain>5</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_pitch_joint</joint_name>
      <topic>/model/armbot/joint/shoulder_pitch_joint/cmd_pos</topic>
      <p_gain>5</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>elbow_pitch_joint</joint_name>
      <topic>/model/armbot/joint/elbow_pitch_joint/cmd_pos</topic>
      <p_gain>5</p_gain>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>finger_left_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>finger_right_joint</joint_name>
    </plugin>

  </model>
</sdf>
