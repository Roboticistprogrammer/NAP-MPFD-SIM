<?xml version="1.0" encoding="UTF-8"?>
<!--
  Claw bench: the ArmBot model alone, mounted upside down as under the drone, with the
  grasp cylinder and a removable support block. No PX4. Used by utility/claw_bench.py to
  check that the servo claw holds the cylinder and that the pad contact sensors (the
  simulated FSRs) report a normal force.
  Run: GZ_SIM_RESOURCE_PATH=<repo>/px4/Tools/simulation/gz/models:<repo>/Grasp_ws/model \
       gz sim -s -r Grasp_ws/worlds/claw_bench.sdf
-->
<sdf version="1.10">
  <world name="claw_bench">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <include>
      <uri>model://Armbot</uri>
      <name>armbot</name>
      <pose>0 0 1.0 3.14159265 0 0</pose>
    </include>
    <joint name="bench_mount" type="fixed">
      <parent>world</parent>
      <child>armbot::base_link</child>
    </joint>

    <include>
      <uri>model://cylinder</uri>
      <name>grasp_cylinder</name>
      <pose>1.0 1.0 0.03 1.5708 0 0</pose>
    </include>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
