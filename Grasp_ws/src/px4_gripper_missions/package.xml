<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>px4_gripper_missions</name>
  <version>0.1.0</version>
  <description>
    Scripted mission programs for Scenarios.md's grasp scenarios (SC-01..SC-05),
    driving PX4 offboard control and the Armbot gripper arm in the
    x500_gripper_armbot combined Gazebo world.
  </description>
  <maintainer email="todo@todo.todo">px4_gazebo_sim_setup</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>px4_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>python3-yaml</depend>

  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
